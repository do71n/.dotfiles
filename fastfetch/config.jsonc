{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "logo": {
        "type": "kitty",
        "source": "~/.dotfiles/fastfetch/images/hollow.png",
        "height": 12,
        "padding": {
            "top": 2,
            "left": 2,
            "right": 3
        },
    },
    "display": {
        "separator": "  ",
        "key": {
            "type": "both-1"
        },
        "constants": [
            "\u001b[38;5;250m󰇙───────────────────────────────"
        ]
    },
    "modules": [
        "break",
        {
            "type": "title",
            "color": {
                "user": "cyan",
                "at": "blue",
                "host": "cyan"
            }
        },
        {
            "type": "custom",
            "format": "{$1}",
            "outputColor": "black"
        },
        {
            "type": "os",
            "key": "os   ",
            "keyColor": "blue"
        },
        {
            "type": "kernel",
            "key": "krnl ",
            "keyColor": "blue"
        },
        {
            "type": "packages",
            "key": "pkgs ",
            "keyColor": "blue"
        },
        {
            "type": "shell",
            "key": "sh   ",
            "keyColor": "blue"
        },
        {
            "type": "terminal",
            "key": "term ",
            "keyColor": "blue"
        },
        {
            "type": "wm",
            "key": "wm   ",
            "keyColor": "blue"
        },
        {
            "type": "uptime",
            "key": "up   ",
            "keyColor": "blue"
        },
        {
            "type": "custom",
            "format": "{$1}",
            "outputColor": "black"
        },
        {
            "type": "cpu",
            "key": "cpu  ",
            "keyColor": "magenta"
        },
        {
            "type": "memory",
            "key": "mem  ",
            "keyColor": "magenta"
        },
        "break",
        {
            "type": "command",
            "key": " ",
            "text": "printf '  \\033[30m󰊠 \\033[31m󰊠 \\033[32m󰊠 \\033[33m󰊠 \\033[34m󰊠 \\033[35m󰊠 \\033[36m󰊠 \\033[37m󰊠'"
        },
        {
            "type": "command",
            "key": " ",
            "text": "printf '  \\033[90m󰊠 \\033[91m󰊠 \\033[92m󰊠 \\033[93m󰊠 \\033[94m󰊠 \\033[95m󰊠 \\033[96m󰊠 \\033[97m󰊠\\033[0m'"
        },
        "break"
    ]
}
